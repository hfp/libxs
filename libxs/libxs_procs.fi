          TYPE(C_PTR) :: preg
          CALL internal_gemm_backend(be,                                &
     &      jit_create_dgemm, jit_get_dgemm,                            &
     &      jit_create_sgemm, jit_get_sgemm,                            &
     &      xgemm_dispatch, dgemm_blas, sgemm_blas, blas_nthreads)
          IF (PRESENT(registry)) THEN
            preg = registry
          ELSE; preg = C_NULL_PTR; END IF
          libxs_syr2k_dispatch_cpy_base = internal_syr2k_dispatch_cpy(  &
     &      config, datatype, n, k, lda, ldb, ldc, be, preg)
        END FUNCTION

        !> Dispatch a SYRK config and populate config.
        FUNCTION libxs_syrk_dispatch_cpy_base(config, datatype,         &
     &  n, k, lda, ldc,                                                 &
     &  jit_create_dgemm, jit_get_dgemm,                                &
     &  jit_create_sgemm, jit_get_sgemm,                                &
     &  xgemm_dispatch, dgemm_blas, sgemm_blas, blas_nthreads,          &
     &  registry)
          TYPE(libxs_gemm_config_t), INTENT(INOUT) :: config
          INTEGER(C_INT), INTENT(IN) :: datatype, n, k
          INTEGER(C_INT), INTENT(IN) :: lda, ldc
          TYPE(C_FUNPTR), INTENT(IN), OPTIONAL ::                       &
     &      jit_create_dgemm, jit_get_dgemm,                            &
     &      jit_create_sgemm, jit_get_sgemm,                            &
     &      xgemm_dispatch, dgemm_blas, sgemm_blas, blas_nthreads
          TYPE(C_PTR), INTENT(IN), OPTIONAL :: registry
          INTEGER(C_INT) :: libxs_syrk_dispatch_cpy_base
          libxs_syrk_dispatch_cpy_base =                                &
     &      libxs_syr2k_dispatch_cpy_base(config, datatype,             &
     &      n, k, lda, lda, ldc,                                        &
     &      jit_create_dgemm, jit_get_dgemm,                            &
     &      jit_create_sgemm, jit_get_sgemm,                            &
     &      xgemm_dispatch, dgemm_blas, sgemm_blas, blas_nthreads,      &
     &      registry)
        END FUNCTION

        !> Pointer-array GEMM batch, split over an OpenMP team unless
        !> the application is serial or already in a parallel region.
        SUBROUTINE libxs_gemm_batch(a_array, b_array, c_array,          &
     &  batchsize, config)
!$        USE OMP_LIB, ONLY: omp_in_parallel, omp_get_max_threads,      &
!$   &      omp_get_thread_num, omp_get_num_threads
          INTEGER(C_INT), INTENT(IN), VALUE :: batchsize
          TYPE(C_PTR), INTENT(IN) :: a_array(*), b_array(*)
          TYPE(C_PTR) :: c_array(*)
          TYPE(libxs_gemm_config_t), INTENT(IN) :: config
          INTEGER(C_INT) :: ntasks
          ntasks = 1
!$        IF (.NOT. omp_in_parallel()) THEN
!$          ntasks = libxs_gemm_ntasks(config, batchsize,               &
!$   &        INT(omp_get_max_threads(), C_INT))
!$        END IF
          IF (1 .LT. ntasks) THEN
!$OMP PARALLEL NUM_THREADS(ntasks) DEFAULT(NONE)                        &
!$OMP&  SHARED(a_array, b_array, c_array, batchsize, config)
!$          CALL libxs_gemm_batch_task(a_array, b_array, c_array,       &
!$   &        batchsize, config,                                        &
!$   &        INT(omp_get_thread_num(), C_INT),                         &
!$   &        INT(omp_get_num_threads(), C_INT))
!$OMP END PARALLEL
          ELSE
            CALL internal_gemm_batch(a_array, b_array, c_array,         &
     &        batchsize, config)
          END IF
        END SUBROUTINE

        !> Index-array GEMM batch, split over an OpenMP team unless
        !> the application is serial or already in a parallel region.
        SUBROUTINE libxs_gemm_index(a, stride_a, b, stride_b,           &
     &  c, stride_c, index_stride, index_base, batchsize, config)
!$        USE OMP_LIB, ONLY: omp_in_parallel, omp_get_max_threads,      &
!$   &      omp_get_thread_num, omp_get_num_threads
          INTEGER(C_INT), INTENT(IN), VALUE ::                          &
     &      index_stride, index_base, batchsize
          TYPE(C_PTR), INTENT(IN), VALUE :: a, b
          TYPE(C_PTR), VALUE :: c
          TYPE(C_PTR), INTENT(IN), VALUE ::                             &
     &      stride_a, stride_b, stride_c
          TYPE(libxs_gemm_config_t), INTENT(IN) :: config
          INTEGER(C_INT) :: ntasks
          ntasks = 1
!$        IF (.NOT. omp_in_parallel()) THEN
!$          ntasks = libxs_gemm_ntasks(config, batchsize,               &
!$   &        INT(omp_get_max_threads(), C_INT))
!$        END IF
          IF (1 .LT. ntasks) THEN
!$OMP PARALLEL NUM_THREADS(ntasks) DEFAULT(NONE)                        &
!$OMP&  SHARED(a, stride_a, b, stride_b, c, stride_c,                   &
!$OMP&  index_stride, index_base, batchsize, config)
!$          CALL libxs_gemm_index_task(a, stride_a, b, stride_b,        &
!$   &        c, stride_c, index_stride, index_base, batchsize,         &
!$   &        config, INT(omp_get_thread_num(), C_INT),                 &
!$   &        INT(omp_get_num_threads(), C_INT))
!$OMP END PARALLEL
          ELSE
            CALL internal_gemm_index(a, stride_a, b, stride_b,          &
     &        c, stride_c, index_stride, index_base, batchsize,         &
     &        config)
          END IF
        END SUBROUTINE

        ! SYR2K split over an OpenMP team unless the application
        ! is serial or already inside a parallel region
        SUBROUTINE internal_syr2k_run(config, uplo,                     &
     &  alpha, beta, a, b, c)
!$        USE OMP_LIB, ONLY: omp_in_parallel, omp_get_max_threads,      &
!$   &      omp_get_thread_num, omp_get_num_threads
          TYPE(libxs_gemm_config_t), INTENT(IN) :: config
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN), VALUE :: alpha, beta
          TYPE(C_PTR), INTENT(IN), VALUE :: a, b
          TYPE(C_PTR), VALUE :: c
          INTEGER(C_INT) :: ntasks
          ntasks = 1
!$        IF (.NOT. omp_in_parallel()) THEN
!$          ntasks = libxs_syrk_ntasks(config,                          &
!$   &        INT(omp_get_max_threads(), C_INT))
!$        END IF
          IF (1 .LT. ntasks) THEN
!$OMP PARALLEL NUM_THREADS(ntasks) DEFAULT(NONE)                        &
!$OMP&  SHARED(config, uplo, alpha, beta, a, b, c)
!$          CALL libxs_syr2k_task(config, uplo, alpha, beta, a, b, c,   &
!$   &        INT(omp_get_thread_num(), C_INT),                         &
!$   &        INT(omp_get_num_threads(), C_INT))
!$OMP END PARALLEL
          ELSE
            CALL internal_syr2k(config, uplo, alpha, beta, a, b, c)
          END IF
        END SUBROUTINE

        ! SYRK split over an OpenMP team unless the application
        ! is serial or already inside a parallel region
        SUBROUTINE internal_syrk_run(config, uplo,                      &
     &  alpha, beta, a, c)
!$        USE OMP_LIB, ONLY: omp_in_parallel, omp_get_max_threads,      &
!$   &      omp_get_thread_num, omp_get_num_threads
          TYPE(libxs_gemm_config_t), INTENT(IN) :: config
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN), VALUE :: alpha, beta
          TYPE(C_PTR), INTENT(IN), VALUE :: a
          TYPE(C_PTR), VALUE :: c
          INTEGER(C_INT) :: ntasks
          ntasks = 1
!$        IF (.NOT. omp_in_parallel()) THEN
!$          ntasks = libxs_syrk_ntasks(config,                          &
!$   &        INT(omp_get_max_threads(), C_INT))
!$        END IF
          IF (1 .LT. ntasks) THEN
!$OMP PARALLEL NUM_THREADS(ntasks) DEFAULT(NONE)                        &
!$OMP&  SHARED(config, uplo, alpha, beta, a, c)
!$          CALL libxs_syrk_task(config, uplo, alpha, beta, a, c,       &
!$   &        INT(omp_get_thread_num(), C_INT),                         &
!$   &        INT(omp_get_num_threads(), C_INT))
!$OMP END PARALLEL
          ELSE
            CALL internal_syrk(config, uplo, alpha, beta, a, c)
          END IF
        END SUBROUTINE

        !> SYR2K with pre-dispatched config.
        SUBROUTINE libxs_syr2k_config(config, uplo,                     &
     &  alpha, beta, a, b, c)
          TYPE(libxs_gemm_config_t), INTENT(IN), TARGET :: config
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN), VALUE :: alpha, beta
          TYPE(C_PTR), INTENT(IN), VALUE :: a, b
          TYPE(C_PTR), VALUE :: c
          CALL internal_syr2k_run(config, uplo, alpha, beta, a, b, c)
        END SUBROUTINE

        !> SYR2K direct (dispatch + call).
        SUBROUTINE libxs_syr2k_direct(datatype, n, k,                   &
     &  lda, ldb, ldc, uplo, alpha, beta, a, b, c, registry)
          INTEGER(C_INT), INTENT(IN) :: datatype, n, k
          INTEGER(C_INT), INTENT(IN) :: lda, ldb, ldc
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN) :: alpha, beta
          TYPE(C_PTR), INTENT(IN) :: a, b
          TYPE(C_PTR) :: c
          TYPE(C_PTR), INTENT(IN), OPTIONAL :: registry
          TYPE(libxs_gemm_config_t) :: cfg
          TYPE(C_PTR) :: preg
          IF (PRESENT(registry)) THEN
            preg = registry
          ELSE; preg = C_NULL_PTR; END IF
          ! the config stays in this frame, hence the copy flavor: a
          ! shape without kernel then owns no registry entry
          IF (0 .NE. libxs_syr2k_dispatch_cpy_base(cfg, datatype,       &
     &      n, k, lda, ldb, ldc, registry=preg)) THEN
            CALL internal_syr2k_run(cfg, uplo, alpha, beta, a, b, c)
          END IF
        END SUBROUTINE

        !> SYRK with pre-dispatched config.
        SUBROUTINE libxs_syrk_config(config, uplo,                      &
     &  alpha, beta, a, c)
          TYPE(libxs_gemm_config_t), INTENT(IN), TARGET :: config
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN), VALUE :: alpha, beta
          TYPE(C_PTR), INTENT(IN), VALUE :: a
          TYPE(C_PTR), VALUE :: c
          CALL internal_syrk_run(config, uplo, alpha, beta, a, c)
        END SUBROUTINE

        !> SYRK direct (dispatch + call).
        SUBROUTINE libxs_syrk_direct(datatype, n, k,                    &
     &  lda, ldc, uplo, alpha, beta, a, c, registry)
          INTEGER(C_INT), INTENT(IN) :: datatype, n, k
          INTEGER(C_INT), INTENT(IN) :: lda, ldc
          CHARACTER(C_CHAR), INTENT(IN), VALUE :: uplo
          REAL(C_DOUBLE), INTENT(IN) :: alpha, beta
          TYPE(C_PTR), INTENT(IN) :: a
          TYPE(C_PTR) :: c
          TYPE(C_PTR), INTENT(IN), OPTIONAL :: registry
          TYPE(libxs_gemm_config_t) :: cfg
          TYPE(C_PTR) :: preg
          IF (PRESENT(registry)) THEN
            preg = registry
          ELSE; preg = C_NULL_PTR; END IF
          ! the config stays in this frame, hence the copy flavor: a
          ! shape without kernel then owns no registry entry
          IF (0 .NE. libxs_syrk_dispatch_cpy_base(cfg, datatype,        &
     &      n, k, lda, ldc, registry=preg)) THEN
            CALL internal_syrk_run(cfg, uplo, alpha, beta, a, c)
          END IF
        END SUBROUTINE

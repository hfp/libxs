        !> Type-size (Bytes) from datatype enum.
        ELEMENTAL FUNCTION libxs_typesize(datatype)
          INTEGER(C_INT), INTENT(IN) :: datatype
          INTEGER(C_INT) :: libxs_typesize
          libxs_typesize = ISHFT(datatype, -4)
        END FUNCTION

        !> Copy a matrix (or zero if source is NULL).
        PURE SUBROUTINE libxs_matcopy(outm, inm, typesize,              &
     &  m, n, ldi, ldo)
          TYPE(C_PTR), INTENT(IN), VALUE :: outm, inm
          INTEGER(C_INT), INTENT(IN), VALUE :: typesize
          INTEGER(C_INT), INTENT(IN), VALUE :: m, n, ldi
          INTEGER(C_INT), INTENT(IN), VALUE, OPTIONAL :: ldo
          IF (PRESENT(ldo)) THEN
            CALL internal_matcopy(outm, inm, typesize,                  &
     &        m, n, ldi, ldo)
          ELSE
            CALL internal_matcopy(outm, inm, typesize,                  &
     &        m, n, ldi, m)
          END IF
        END SUBROUTINE

        !> Copy a matrix: task variant for external threading.
        PURE SUBROUTINE libxs_matcopy_task(outm, inm,                   &
     &  typesize, m, n, ldi, ldo, tid, ntasks)
          TYPE(C_PTR), INTENT(IN), VALUE :: outm, inm
          INTEGER(C_INT), INTENT(IN), VALUE :: typesize
          INTEGER(C_INT), INTENT(IN), VALUE ::                          &
     &      m, n, ldi, tid, ntasks
          INTEGER(C_INT), INTENT(IN), VALUE, OPTIONAL :: ldo
          IF (PRESENT(ldo)) THEN
            CALL internal_matcopy_task(outm, inm, typesize,             &
     &        m, n, ldi, ldo, tid, ntasks)
          ELSE
            CALL internal_matcopy_task(outm, inm, typesize,             &
     &        m, n, ldi, m, tid, ntasks)
          END IF
        END SUBROUTINE

        !> Out-of-place matrix transpose.
        PURE SUBROUTINE libxs_otrans(outm, inm, typesize,               &
     &  m, n, ldi, ldo)
          TYPE(C_PTR), INTENT(IN), VALUE :: outm, inm
          INTEGER(C_INT), INTENT(IN), VALUE :: typesize
          INTEGER(C_INT), INTENT(IN), VALUE :: m, n, ldi
          INTEGER(C_INT), INTENT(IN), VALUE, OPTIONAL :: ldo
          IF (PRESENT(ldo)) THEN
            CALL internal_otrans(outm, inm, typesize,                   &
     &        m, n, ldi, ldo)
          ELSE
            CALL internal_otrans(outm, inm, typesize,                   &
     &        m, n, ldi, n)
          END IF
        END SUBROUTINE

        !> Out-of-place transpose: task variant.
        PURE SUBROUTINE libxs_otrans_task(outm, inm,                    &
     &  typesize, m, n, ldi, ldo, tid, ntasks)
          TYPE(C_PTR), INTENT(IN), VALUE :: outm, inm
          INTEGER(C_INT), INTENT(IN), VALUE :: typesize
          INTEGER(C_INT), INTENT(IN), VALUE ::                          &
     &      m, n, ldi, tid, ntasks
          INTEGER(C_INT), INTENT(IN), VALUE, OPTIONAL :: ldo
          IF (PRESENT(ldo)) THEN
            CALL internal_otrans_task(outm, inm, typesize,              &
     &        m, n, ldi, ldo, tid, ntasks)
          ELSE
            CALL internal_otrans_task(outm, inm, typesize,              &
     &        m, n, ldi, n, tid, ntasks)
          END IF
        END SUBROUTINE

        !> Allocate from a pool reaching steady-state.
        FUNCTION libxs_malloc_bytes(pool, nbytes, alignment)
          TYPE(C_PTR), INTENT(IN) :: pool
          INTEGER(C_SIZE_T), INTENT(IN) :: nbytes
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: alignment
          TYPE(C_PTR) :: libxs_malloc_bytes
          IF (PRESENT(alignment)) THEN
            libxs_malloc_bytes =                                        &
     &        libxs_malloc_c(pool, nbytes, alignment)
          ELSE
            libxs_malloc_bytes =                                        &
     &        libxs_malloc_c(pool, nbytes, 0)
          END IF
        END FUNCTION

        !> Check SIMD alignment, optionally for the next access
        !> (inc, Bytes) and yielding the actual alignment.
        FUNCTION libxs_aligned(ptr, inc, alignment)
          TYPE(C_PTR), INTENT(IN) :: ptr
          INTEGER(C_SIZE_T), INTENT(IN), OPTIONAL,                      &
     &      TARGET :: inc
          INTEGER(C_INT), INTENT(OUT), OPTIONAL,                        &
     &      TARGET :: alignment
          INTEGER(C_INT) :: libxs_aligned
          TYPE(C_PTR) :: pinc, palign
          IF (PRESENT(inc)) THEN; pinc = C_LOC(inc)
          ELSE; pinc = C_NULL_PTR; END IF
          IF (PRESENT(alignment)) THEN
            palign = C_LOC(alignment)
          ELSE; palign = C_NULL_PTR; END IF
          libxs_aligned =                                               &
     &      internal_aligned(ptr, pinc, palign)
        END FUNCTION

        ! matdiff wrapper with OPTIONAL arguments;
        ! bound selects the componentwise grade driver.
        SUBROUTINE libxs_matdiff(info, datatype, m, n,                  &
     &  ref, tst, ldref, ldtst, bound, ldbnd, rc)
          INTEGER(C_INT), INTENT(IN) :: datatype
          INTEGER(C_INT), INTENT(IN) :: m
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: n, ldref, ldtst
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: ldbnd
          TYPE(C_PTR), INTENT(IN), OPTIONAL :: ref, tst, bound
          TYPE(libxs_matdiff_t), INTENT(OUT) :: info
          ! Nonzero unless the difference was calculated.
          INTEGER(C_INT), INTENT(OUT), OPTIONAL :: rc
          INTEGER(C_INT) :: nn, res
          INTEGER(C_INT), TARGET :: lr, lt, lb
          TYPE(C_PTR) :: rr, tt, plr, plt, plb
          INTERFACE
            FUNCTION internal_matdiff(info,                             &
     &      datatype, m, n, ref, tst, ldref, ldtst)                     &
     &      RESULT(res) BIND(C, NAME="libxs_matdiff")
              IMPORT :: libxs_matdiff_t, C_PTR, C_INT
              INTEGER(C_INT), INTENT(IN), VALUE :: datatype
              INTEGER(C_INT), INTENT(IN), VALUE :: m, n
              TYPE(C_PTR), INTENT(IN), VALUE :: ref, tst
              TYPE(C_PTR), INTENT(IN), VALUE :: ldref, ldtst
              TYPE(libxs_matdiff_t), INTENT(OUT) :: info
              INTEGER(C_INT) :: res
            END FUNCTION
            FUNCTION internal_grade(info, datatype, m, n,               &
     &      ref, tst, bound, ldref, ldtst, ldbnd)                       &
     &      RESULT(res) BIND(C, NAME="libxs_matdiff_grade")
              IMPORT :: libxs_matdiff_t, C_PTR, C_INT
              INTEGER(C_INT), INTENT(IN), VALUE :: datatype
              INTEGER(C_INT), INTENT(IN), VALUE :: m, n
              TYPE(C_PTR), INTENT(IN), VALUE :: ref, tst
              TYPE(C_PTR), INTENT(IN), VALUE :: bound
              TYPE(C_PTR), INTENT(IN), VALUE :: ldref, ldtst
              TYPE(C_PTR), INTENT(IN), VALUE :: ldbnd
              TYPE(libxs_matdiff_t), INTENT(OUT) :: info
              INTEGER(C_INT) :: res
            END FUNCTION
          END INTERFACE
          IF (PRESENT(n)) THEN; nn = n; ELSE; nn = m; END IF
          IF (PRESENT(ref)) THEN; rr = ref
          ELSE; rr = C_NULL_PTR; END IF
          IF (PRESENT(tst)) THEN; tt = tst
          ELSE; tt = C_NULL_PTR; END IF
          IF (PRESENT(ldref)) THEN
            lr = ldref; plr = C_LOC(lr)
          ELSE; plr = C_NULL_PTR; END IF
          IF (PRESENT(ldtst)) THEN
            lt = ldtst; plt = C_LOC(lt)
          ELSE; plt = C_NULL_PTR; END IF
          IF (PRESENT(ldbnd)) THEN
            lb = ldbnd; plb = C_LOC(lb)
          ELSE; plb = C_NULL_PTR; END IF
          IF (PRESENT(bound)) THEN
            res = internal_grade(info, datatype, m, nn,                 &
     &        rr, tt, bound, plr, plt, plb)
          ELSE
            res = internal_matdiff(info, datatype, m, nn,               &
     &        rr, tt, plr, plt)
          END IF
          IF (PRESENT(rc)) rc = res
        END SUBROUTINE

        !> General fingerprint: C_PTR data, explicit shape/stride.
        FUNCTION libxs_fprint_ptr(info, datatype, data,                 &
     &  ndims, shape, stride, order, axis, smooth, flags)               &
     &  RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(OUT) :: info
          INTEGER(C_INT), INTENT(IN) :: datatype
          TYPE(C_PTR), INTENT(IN) :: data
          INTEGER(C_INT), INTENT(IN) :: ndims
          INTEGER(C_SIZE_T), INTENT(IN), TARGET :: shape(ndims)
          INTEGER(C_SIZE_T), INTENT(IN), OPTIONAL, TARGET ::            &
     &      stride(ndims)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order, axis
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: smooth, flags
          INTEGER(C_INT) :: rc
          INTEGER(C_INT) :: oo, aa, ss, ff
          TYPE(C_PTR) :: pstride
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          IF (PRESENT(axis)) THEN; aa = axis
          ELSE; aa = 0; END IF
          IF (PRESENT(smooth)) THEN; ss = smooth
          ELSE; ss = 0; END IF
          IF (PRESENT(flags)) THEN; ff = flags
          ELSE; ff = 0; END IF
          IF (PRESENT(stride)) THEN; pstride = C_LOC(stride)
          ELSE; pstride = C_NULL_PTR; END IF
          rc = internal_fprint(info, datatype, data,                    &
     &      ndims, C_LOC(shape), pstride, oo, aa, ss, ff)
        END FUNCTION

        !> 1-D fingerprint for REAL(C_DOUBLE).
        FUNCTION libxs_fprint_f64(info, data, order, axis,              &
     &  smooth, flags) RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(OUT) :: info
          REAL(C_DOUBLE), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order, axis
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: smooth, flags
          INTEGER(C_INT) :: rc
          INTEGER(C_INT) :: oo, aa, ss, ff
          INTEGER(C_SIZE_T), TARGET :: shp(1)
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          IF (PRESENT(axis)) THEN; aa = axis
          ELSE; aa = 0; END IF
          IF (PRESENT(smooth)) THEN; ss = smooth
          ELSE; ss = 0; END IF
          IF (PRESENT(flags)) THEN; ff = flags
          ELSE; ff = 0; END IF
          shp(1) = SIZE(data, KIND=C_SIZE_T)
          rc = internal_fprint(info, LIBXS_DATATYPE_F64,                &
     &      C_LOC(data), 1, C_LOC(shp), C_NULL_PTR, oo, aa, ss, ff)
        END FUNCTION

        !> 1-D fingerprint for REAL(C_FLOAT).
        FUNCTION libxs_fprint_f32(info, data, order, axis,              &
     &  smooth, flags) RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(OUT) :: info
          REAL(C_FLOAT), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order, axis
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: smooth, flags
          INTEGER(C_INT) :: rc
          INTEGER(C_INT) :: oo, aa, ss, ff
          INTEGER(C_SIZE_T), TARGET :: shp(1)
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          IF (PRESENT(axis)) THEN; aa = axis
          ELSE; aa = 0; END IF
          IF (PRESENT(smooth)) THEN; ss = smooth
          ELSE; ss = 0; END IF
          IF (PRESENT(flags)) THEN; ff = flags
          ELSE; ff = 0; END IF
          shp(1) = SIZE(data, KIND=C_SIZE_T)
          rc = internal_fprint(info, LIBXS_DATATYPE_F32,                &
     &      C_LOC(data), 1, C_LOC(shp), C_NULL_PTR, oo, aa, ss, ff)
        END FUNCTION

        !> 1-D fingerprint for INTEGER(C_INT).
        FUNCTION libxs_fprint_i32(info, data, order, axis,              &
     &  smooth, flags) RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(OUT) :: info
          INTEGER(C_INT), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order, axis
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: smooth, flags
          INTEGER(C_INT) :: rc
          INTEGER(C_INT) :: oo, aa, ss, ff
          INTEGER(C_SIZE_T), TARGET :: shp(1)
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          IF (PRESENT(axis)) THEN; aa = axis
          ELSE; aa = 0; END IF
          IF (PRESENT(smooth)) THEN; ss = smooth
          ELSE; ss = 0; END IF
          IF (PRESENT(flags)) THEN; ff = flags
          ELSE; ff = 0; END IF
          shp(1) = SIZE(data, KIND=C_SIZE_T)
          rc = internal_fprint(info, LIBXS_DATATYPE_I32,                &
     &      C_LOC(data), 1, C_LOC(shp), C_NULL_PTR, oo, aa, ss, ff)
        END FUNCTION

        !> 1-D fingerprint for INTEGER(C_INT8_T).
        FUNCTION libxs_fprint_i8(info, data, order, axis,               &
     &  smooth, flags) RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(OUT) :: info
          INTEGER(C_INT8_T), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order, axis
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: smooth, flags
          INTEGER(C_INT) :: rc
          INTEGER(C_INT) :: oo, aa, ss, ff
          INTEGER(C_SIZE_T), TARGET :: shp(1)
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          IF (PRESENT(axis)) THEN; aa = axis
          ELSE; aa = 0; END IF
          IF (PRESENT(smooth)) THEN; ss = smooth
          ELSE; ss = 0; END IF
          IF (PRESENT(flags)) THEN; ff = flags
          ELSE; ff = 0; END IF
          shp(1) = SIZE(data, KIND=C_SIZE_T)
          rc = internal_fprint(info, LIBXS_DATATYPE_I8,                 &
     &      C_LOC(data), 1, C_LOC(shp), C_NULL_PTR, oo, aa, ss, ff)
        END FUNCTION

        !> Weighted Sobolev distance between two fingerprints.
        FUNCTION libxs_fprint_diff(a, b, weights)
          TYPE(libxs_fprint_t), INTENT(IN) :: a, b
          REAL(C_DOUBLE), INTENT(IN), OPTIONAL, TARGET ::               &
     &      weights(*)
          REAL(C_DOUBLE) :: libxs_fprint_diff
          IF (PRESENT(weights)) THEN
            libxs_fprint_diff = internal_fprint_diff(                   &
     &        a, b, C_LOC(weights))
          ELSE
            libxs_fprint_diff = internal_fprint_diff(                   &
     &        a, b, C_NULL_PTR)
          END IF
        END FUNCTION

        !> Streaming fingerprint for REAL(C_DOUBLE).
        FUNCTION libxs_fprint_partial_f64(info, data, order)            &
     &  RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(INOUT) :: info
          REAL(C_DOUBLE), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order
          INTEGER(C_INT) :: rc, oo
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          rc = internal_fprint_partial(info, LIBXS_DATATYPE_F64,        &
     &      C_LOC(data), INT(SIZE(data), C_INT), oo)
        END FUNCTION

        !> Streaming fingerprint for REAL(C_FLOAT).
        FUNCTION libxs_fprint_partial_f32(info, data, order)            &
     &  RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(INOUT) :: info
          REAL(C_FLOAT), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order
          INTEGER(C_INT) :: rc, oo
          IF (PRESENT(order)) THEN; oo = order
          ELSE; oo = LIBXS_FPRINT_MAXORDER; END IF
          rc = internal_fprint_partial(info, LIBXS_DATATYPE_F32,        &
     &      C_LOC(data), INT(SIZE(data), C_INT), oo)
        END FUNCTION

        !> Streaming fingerprint for INTEGER(C_INT).
        FUNCTION libxs_fprint_partial_i32(info, data, order)            &
     &  RESULT(rc)
          TYPE(libxs_fprint_t), INTENT(INOUT) :: info
          INTEGER(C_INT), INTENT(IN), TARGET :: data(:)
          INTEGER(C_INT), INTENT(IN), OPTIONAL :: order
          INTEGER(C_INT) :: rc, oo
